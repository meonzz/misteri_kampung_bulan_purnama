rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isModerator(gameId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/games/$(gameId)).data.moderatorUid == request.auth.uid;
    }

    match /games/{gameId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.moderatorUid == request.auth.uid ||
        (
          resource.data.moderatorUid == null &&
          request.resource.data.moderatorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderatorUid','pinAttempt']) &&
          request.resource.data.pinAttempt ==
            get(/databases/$(database)/documents/games/$(gameId)/players/$(resource.data.moderatorPlayerId)).data.moderatorPin
        )
      );
      allow delete: if isModerator(gameId);

      match /publicPlayers/{playerId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          isModerator(gameId) ||
          (
            resource.data.claimed == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
          )
        );
        allow delete: if isModerator(gameId);
      }

      match /players/{playerId} {
        allow read: if isSignedIn() && (
          resource.data.claimedUid == request.auth.uid || isModerator(gameId)
        );
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          isModerator(gameId) ||
          (
            resource.data.claimedUid == null &&
            request.resource.data.claimedUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid'])
          )
        );
        allow delete: if isModerator(gameId);
      }
    }
  }
}
